# Copy to .env.local and fill in. Never commit real values.

# --- Fireblocks (creates one vault per order) ---
FIREBLOCKS_API_KEY=
# API user's RSA private key (PEM contents). Multi-line in quotes, or one line with literal \n.
FIREBLOCKS_SECRET_KEY=
FIREBLOCKS_BASE_PATH=https://sandbox-api.fireblocks.io/v1
# Fireblocks asset ID matching the settlement token/chain below (USDC on Base by default).
FIREBLOCKS_ASSET_ID=USDC_BASECHAIN_ETH_5I5C

# --- Dynamic / Fireblocks Flow ---
DYNAMIC_API_BASE_URL=https://app.dynamicauth.com/api/v0
# Environment API token with flow.write scope (server only).
DYNAMIC_API_TOKEN=
# Secret from the webhook detail page in the Dynamic developer console.
DYNAMIC_WEBHOOK_SECRET=
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# --- Settlement (what lands in the vault) ---
SETTLEMENT_CHAIN_ID=8453
SETTLEMENT_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
SETTLEMENT_TOKEN_SYMBOL=USDC
SETTLEMENT_TOKEN_DECIMALS=6
